	column weather_key = [origin] & "|" & [time_hour]
		lineageTag: 1abd101b-a3bc-47c3-b1db-26e21dca850e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column weather_condition =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(nyc_weather[precip]), "Unknown",
			    nyc_weather[precip] > 0, "Precipitation",
			    "No Precipitation"
			)
		lineageTag: 3d023c29-640d-4d1a-9044-f5af018ac9da
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column weather_key_etl
		dataType: string
		lineageTag: 9291acac-2a9d-4b9d-994f-5a4f2ca4e5f9
		summarizeBy: none
		sourceColumn: weather_key_etl

		annotation SummarizationSetBy = Automatic

	column 'Visibility Range' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(nyc_weather[visib]), "Unknown",
			    nyc_weather[visib] < 2, "Under 2 mi",
			    nyc_weather[visib] < 5, "2–5 mi",
			    nyc_weather[visib] < 10, "5–10 mi",
			    "10+ mi"
			)
		lineageTag: ccdb243a-ebeb-4564-ac00-4439e19eafd1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition nyc_weather = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\99848819\Downloads\nyc_weather.csv"),[Delimiter=",", Columns=15, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"origin", type text}, {"year", Int64.Type}, {"month", Int64.Type}, {"day", Int64.Type}, {"hour", Int64.Type}, {"temp", type number}, {"dewp", type number}, {"humid", type number}, {"wind_dir", type text}, {"wind_speed", type number}, {"wind_gust", type text}, {"precip", Int64.Type}, {"pressure", type text}, {"visib", Int64.Type}, {"time_hour", type text}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "weather_key_etl", each Text.From([origin]) & "|" & Text.From([time_hour]))
				in
				    #"Added Custom"

